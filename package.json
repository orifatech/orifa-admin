{
  "name": "orifa-admin",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:agency": "npm --prefix apps/agency run dev",
    "dev:clients": "npm --prefix apps/clients run dev",
    "dev:portal": "npm --prefix apps/clients run dev",
    "dev:convex": "npm --prefix packages/backend run dev",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "tsc --noEmit",
    "check:unused": "knip --no-exit-code",
    "check:unused:strict": "knip",
    "release": "standard-version",
    "release:minor": "standard-version --release-as minor",
    "release:patch": "standard-version --release-as patch",
    "release:major": "standard-version --release-as major",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@convex-dev/auth": "^0.0.96",
    "@octokit/rest": "^22.0.1",
    "clsx": "^2.1.1",
    "convex": "^1.46.0",
    "lucide-react": "^1.56.0",
    "next": "^16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0"
  },
  "optionalDependencies": {
    "@img/sharp-libvips-linux-arm64": "^1.3.4",
    "@img/sharp-linux-arm64": "^0.35.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "husky": "^9.1.7",
    "knip": "^6.41.0",
    "lint-staged": "^17.6.0",
    "standard-version": "^9.5.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
