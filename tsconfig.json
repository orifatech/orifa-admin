{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "paths": {
      "@orifa/backend": ["./packages/backend"],
      "@orifa/backend/*": ["./packages/backend/*"],
      "@convex/*": ["./packages/backend/convex/*"],
      "@orifa/ui": ["./packages/ui"],
      "@orifa/ui/*": ["./packages/ui/*"],
      "@/*": ["./apps/agency-admin/src/*"]
    }
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "packages/**/*.tsx"
  ],
  "exclude": ["node_modules", "**/dist", "**/.next"]
}
